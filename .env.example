# Register a GitHub OAuth app with callback http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3000
# DATA_DIR=.data
# Optional provider-neutral endpoint; see docs/generation.md for the draft schema.
# Legacy {"text":"..."} responses are also accepted after validation.
# Receives normalized evidence and bounded, redacted excerpts, never full source files.
AI_ENDPOINT=
AI_API_KEY=
